{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://ut4recon.local/schemas/editor-map-check-report-v1.json",
  "type": "object", "required": ["schemaVersion", "log", "errors", "warnings", "messages", "passed"],
  "properties": {
    "schemaVersion": { "const": 1 }, "log": { "type": "object" },
    "errors": { "type": "integer", "minimum": 0 }, "warnings": { "type": "integer", "minimum": 0 },
    "messages": { "type": "array", "items": { "type": "string" } }, "passed": { "type": "boolean" }
  }, "additionalProperties": false
}
